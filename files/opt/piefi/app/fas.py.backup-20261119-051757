@fas.route("/fas/fas-hid.php", methods=["GET", "POST"])
def fas_login():
    encoded = request.values.get("fas", "")
    client = parse_fas_query(encoded)

    if not client:
        return "Invalid OpenNDS authentication request.", 400

    if request.method == "GET":
        return render_template_string(PAGE, encoded=encoded, error=None)

    code = request.form.get("code", "").strip().upper()

    if not code or len(code) > 32:
        return render_template_string(
            PAGE, encoded=encoded, error="Invalid voucher code."
        ), 400

    key = os.environ.get("PIEFI_FAS_KEY", "")
    if not key:
        return "FAS key is not configured.", 503

    reservation_id = secrets.token_urlsafe(24)
    now = int(time.time())

    try:
        with db_connect() as conn:
            conn.execute("BEGIN IMMEDIATE")

            conn.execute("""
                CREATE TABLE IF NOT EXISTS pending_auth (
                    id TEXT PRIMARY KEY,
                    voucher_code TEXT NOT NULL UNIQUE,
                    client_ip TEXT NOT NULL,
                    client_mac TEXT NOT NULL,
                    hid TEXT NOT NULL,
                    created_at INTEGER NOT NULL,
                    expires_at INTEGER NOT NULL,
                    status TEXT NOT NULL DEFAULT 'pending'
                )
            """)

            # Remove expired reservations so vouchers can be retried.
            conn.execute(
                "DELETE FROM pending_auth WHERE expires_at <= ? AND status='pending'",
                (now,)
            )

            voucher = conn.execute(
                "SELECT * FROM vouchers WHERE code=? AND status='unused'",
                (code,)
            ).fetchone()

            if not voucher:
                return render_template_string(
                    PAGE, encoded=encoded, error="Voucher is invalid or already used."
                ), 400

            conn.execute("""
                INSERT INTO pending_auth
                (id, voucher_code, client_ip, client_mac, hid,
                 created_at, expires_at, status)
                VALUES (?, ?, ?, ?, ?, ?, ?, 'pending')
            """, (
                reservation_id, code, client["clientip"],
                client["clientmac"], client["hid"], now, now + 300
            ))

    except sqlite3.IntegrityError:
        return render_template_string(
            PAGE, encoded=encoded,
            error="This voucher is already being processed."
        ), 409
    except sqlite3.Error:
        return "Voucher database error.", 500

    token = hashlib.sha256(
        (client["hid"] + key).encode("utf-8")
    ).hexdigest()

    custom = base64.b64encode(
        ("piefi:" + reservation_id).encode("utf-8")
    ).decode("ascii")

    gateway = client["gatewayaddress"]
    auth_url = "http://" + gateway + ":2050/opennds_auth/"
    fas_url = request.url_root.rstrip("/") + "/fas/fas-hid.php"
    redir = fas_url + "?" + urlencode({
        "fas": encoded,
        "landing": "1"
    })

    return render_template_string("""
    <!doctype html>
    <html><head><meta name="viewport" content="width=device-width,initial-scale=1">
    <title>pieFi - Connect</title></head>
    <body style="font-family:Arial;text-align:center;padding:40px">
    <h2>Voucher verified</h2>
    <p>Press Continue to request internet access.</p>
    <form action="{{ auth_url }}" method="get">
    <input type="hidden" name="tok" value="{{ token }}">
    <input type="hidden" name="custom" value="{{ custom }}">
    <input type="hidden" name="redir" value="{{ redir }}">
    <button style="padding:14px 30px">Continue</button>
    </form></body></html>
    """, auth_url=auth_url, token=token, custom=custom, redir=redir)


def register_fas(app):
    app.register_blueprint(fas)
