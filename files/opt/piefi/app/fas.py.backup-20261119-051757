import base64
import hashlib
import os
import secrets
import sqlite3
import time
from urllib.parse import quote, urlencode

from flask import Blueprint, request, render_template_string

fas = Blueprint("piefi_fas", __name__)

DB = os.environ.get("PIEFI_DB", "/etc/piefi/piefi.sqlite3")


def db_connect():
    conn = sqlite3.connect(DB, timeout=10)
    conn.row_factory = sqlite3.Row
    return conn


def parse_fas_query(encoded):
    try:
        raw = base64.b64decode(encoded, validate=True).decode("utf-8")
        result = {}

        for item in raw.split(", "):
            if "=" in item:
                key, value = item.split("=", 1)
                result[key.strip()] = value.strip()

        required = ("hid", "gatewayaddress", "clientip", "clientmac")
        if not all(result.get(key) for key in required):
            return None

        return result
    except Exception:
        return None


PAGE = """
