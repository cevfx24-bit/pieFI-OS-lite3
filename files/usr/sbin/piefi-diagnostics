#!/bin/sh
# pieFi OS Lite diagnostics - read-only
echo "===== SYSTEM ====="
ubus call system board 2>/dev/null
echo "===== LINKS / ADDRESSES / ROUTES ====="
ip -br link 2>&1
ip -br addr 2>&1
ip route 2>&1
echo "===== NETWORK UCI ====="
uci show network 2>&1
echo "===== DHCP / DNS UCI ====="
uci show dhcp 2>&1
echo "===== DNS RESOLVERS ====="
cat /etc/resolv.conf 2>/dev/null
cat /tmp/resolv.conf.d/resolv.conf.auto 2>/dev/null
echo "===== DNS TEST ====="
nslookup example.com 2>&1
echo "===== FIREWALL ====="
uci show firewall 2>&1
nft list ruleset 2>&1
echo "===== WIFI ====="
uci show wireless 2>&1
iw dev 2>&1
echo "===== PACKAGES ====="
for p in opennds nginx-ssl python3-flask python3-sqlite3 dnsmasq firewall4; do
  echo "--- $p ---"
  apk info -e "$p" 2>&1
done
echo "===== SERVICES ====="
for s in piefi nginx dnsmasq firewall opennds; do
  echo "--- $s ---"
  if [ -x "/etc/init.d/$s" ]; then
    /etc/init.d/"$s" status 2>&1
  else
    echo "INIT SCRIPT MISSING"
  fi
done
echo "===== LISTENING PORTS ====="
ss -lntup 2>&1
echo "===== RECENT LOGS ====="
logread 2>/dev/null | grep -iE 'dnsmasq|dns|piefi|nginx|opennds|firewall|error|failed' | tail -n 100
echo "===== END ====="
