#!/bin/sh

set -eu

ENV_DIR="/etc/piefi"
ENV_FILE="$ENV_DIR/piefi.env"
CREDENTIAL_FILE="/root/piefi-initial-credentials.txt"

mkdir -p "$ENV_DIR"
chmod 700 "$ENV_DIR"

if [ ! -s "$ENV_FILE" ]; then
    SECRET="$(/usr/bin/openssl rand -hex 32)"
    # User-requested fixed default administrator password.
    PASSWORD="piefi3645"
    FAS_KEY="$(/usr/bin/openssl rand -hex 32)"
    CONTROLLER_TOKEN="$(/usr/bin/openssl rand -hex 32)"

    umask 077
    cat > "$ENV_FILE" <<EOC
PIEFI_SECRET_KEY=$SECRET
PIEFI_FAS_KEY=$FAS_KEY
PIEFI_CONTROLLER_TOKEN=$CONTROLLER_TOKEN
PIEFI_ADMIN_USER=admin
PIEFI_ADMIN_PASSWORD=$PASSWORD
PIEFI_DB=/etc/piefi/piefi.sqlite3
EOC

    cat > "$CREDENTIAL_FILE" <<EOC
PieFI OS Lite - Administrator Credentials
Username: admin
Password: $PASSWORD

User-requested default credential. Keep this file private.
EOC

    chmod 600 "$ENV_FILE" "$CREDENTIAL_FILE"
fi

# Ensure an existing environment also has a FAS key.
FAS_KEY="$(sed -n 's/^PIEFI_FAS_KEY=//p' "$ENV_FILE" | tail -n 1)"

if [ -z "$FAS_KEY" ]; then
    FAS_KEY="$(/usr/bin/openssl rand -hex 32)"
    sed -i '/^PIEFI_FAS_KEY=/d' "$ENV_FILE"
    printf 'PIEFI_FAS_KEY=%s\n' "$FAS_KEY" >> "$ENV_FILE"
fi

# Ensure a random controller API token exists for ESP32 primary / ESP8266 backup.
CONTROLLER_TOKEN="$(sed -n 's/^PIEFI_CONTROLLER_TOKEN=//p' "$ENV_FILE" | tail -n 1)"
if [ -z "$CONTROLLER_TOKEN" ]; then
    CONTROLLER_TOKEN="$(/usr/bin/openssl rand -hex 32)"
    printf 'PIEFI_CONTROLLER_TOKEN=%s\n' "$CONTROLLER_TOKEN" >> "$ENV_FILE"
fi

chmod 600 "$ENV_FILE"

# Configure OpenNDS with the same key used by Flask.
uci set opennds.@opennds[0].enabled='1'
uci set opennds.@opennds[0].gatewayinterface='br-lan'
uci set opennds.@opennds[0].gatewayport='2050'
uci set opennds.@opennds[0].fasport='2080'
uci set opennds.@opennds[0].faspath='/fas/fas-hid.php'
uci set opennds.@opennds[0].fas_secure_enabled='1'
uci set opennds.@opennds[0].faskey="$FAS_KEY"
uci set opennds.@opennds[0].binauth="/opt/piefi/app/piefi-binauth.sh"
uci commit opennds

/etc/init.d/nginx enable
/etc/init.d/piefi enable
/etc/init.d/opennds enable


# PIEFI_WEB_PORTS_CONFIGURED
# Reserve port 80 for the PieFI dashboard; keep LuCI on alternate ports.
if command -v uci >/dev/null 2>&1; then
    uci -q delete uhttpd.main.listen_http || true
    uci add_list uhttpd.main.listen_http='0.0.0.0:8082'
    uci add_list uhttpd.main.listen_http='[::]:8082'
    uci -q delete uhttpd.main.listen_https || true
    uci add_list uhttpd.main.listen_https='0.0.0.0:8443'
    uci add_list uhttpd.main.listen_https='[::]:8443'
    uci commit uhttpd
fi

exit 0
