#!/bin/sh
# Set the visible system identity to PieFi OS Lite while preserving
# OpenWrt's internal distribution ID for package/sysupgrade compatibility.
uci set system.@system[0].hostname='piefi'
uci set system.@system[0].description='PieFi OS Lite V3 - PisoWiFi Network Operating System'
uci commit system

# The generated release file contains build-specific revision/target values.
# Change only its human-readable description; keep technical IDs untouched.
if [ -f /etc/openwrt_release ]; then
    if grep -q '^DISTRIB_DESCRIPTION=' /etc/openwrt_release; then
        sed -i "s|^DISTRIB_DESCRIPTION=.*|DISTRIB_DESCRIPTION='PieFi OS Lite V3'|" /etc/openwrt_release
    else
        printf "DISTRIB_DESCRIPTION='PieFi OS Lite V3'\\n" >> /etc/openwrt_release
    fi
fi

# Rebrand the boot menu title if the x86 image provides a GRUB config.
if [ -f /boot/grub/grub.cfg ]; then
    sed -i 's/OpenWrt/PieFi OS Lite/g' /boot/grub/grub.cfg
fi

exit 0
