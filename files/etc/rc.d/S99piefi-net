#!/bin/sh /etc/rc.common
START=99
STOP=10

start() {
    # USB NICs can enumerate after boot. Retry for up to 20 seconds.
    n=0
    while [ "$n" -lt 10 ]; do
        [ -e /sys/class/net/eth0 ] && break
        sleep 2
        n=$((n + 1))
    done
    n=0
    while [ "$n" -lt 10 ] && [ ! -e /sys/class/net/eth1 ]; do
        sleep 2
        n=$((n + 1))
    done
    /usr/sbin/piefi-net-detect
}
