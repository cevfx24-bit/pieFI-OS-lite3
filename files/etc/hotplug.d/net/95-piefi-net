#!/bin/sh
# Re-run network setup when either expected NIC appears or disappears.
case "$INTERFACE" in
    eth0|eth1) ;;
    *) exit 0 ;;
esac
case "$ACTION" in
    add|remove) ;;
    *) exit 0 ;;
esac
(
    # Let sysfs/netifd settle after add/remove before checking interface state.
    sleep 2
    /usr/sbin/piefi-net-detect
) >/dev/null 2>&1 &
exit 0
