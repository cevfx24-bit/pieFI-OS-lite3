#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
    local enabled bind port database
    config_load piefi
    config_get_bool enabled main enabled 0
    config_get bind main bind '127.0.0.1'
    config_get port main port '8080'
    config_get database main database '/etc/piefi/piefi.sqlite3'
    [ "$enabled" -eq 1 ] || return 0
    [ -x /usr/bin/python3 ] || { logger -t piefi 'python3 missing; service not started'; return 1; }
    [ -f /opt/piefi/app/app.py ] || return 1
    [ -f /etc/piefi/piefi.env ] || { logger -t piefi 'Create /etc/piefi/piefi.env before enabling'; return 1; }
    . /etc/piefi/piefi.env
    [ -n "$PIEFI_SECRET_KEY" ] && [ "$PIEFI_SECRET_KEY" != 'REPLACE_WITH_LONG_RANDOM_SECRET' ] || { logger -t piefi 'Set a unique PIEFI_SECRET_KEY'; return 1; }
    [ -n "$PIEFI_ADMIN_PASSWORD" ] && [ "$PIEFI_ADMIN_PASSWORD" != 'REPLACE_WITH_UNIQUE_PASSWORD' ] || { logger -t piefi 'Set a unique admin password'; return 1; }
    procd_open_instance
    procd_set_param command /usr/bin/python3 /opt/piefi/app/app.py
    procd_set_param env PIEFI_BIND="$bind" PIEFI_PORT="$port" PIEFI_DB="$database"
    procd_set_param env PIEFI_SECRET_KEY="$PIEFI_SECRET_KEY" PIEFI_FAS_KEY="${PIEFI_FAS_KEY:-}" PIEFI_CONTROLLER_TOKEN="${PIEFI_CONTROLLER_TOKEN:-}" PIEFI_ADMIN_USER="${PIEFI_ADMIN_USER:-admin}" PIEFI_ADMIN_PASSWORD="$PIEFI_ADMIN_PASSWORD" PIEFI_ADMIN_PASSWORD_HASH="${PIEFI_ADMIN_PASSWORD_HASH:-}"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
